import random
import math

# Random Fun Calculator
print("===== Random Fun Calculator =====")

# Step 1 & 2: Generate a lucky number
lucky_number = random.randint(1, 10)
print("\nYour lucky number is:", lucky_number)

# Step 3: Choose a random activity
fun_choices = [
    "Watch a movie",
    "Play a video game",
    "Listen to music",
    "Go for a walk",
    "Eat your favorite snack"
]

activity = random.choice(fun_choices)
print("Your random activity is:", activity)

# Step 4: Number guessing game
secret_number = random.randint(1, 5)

print("\n===== Guessing Game =====")
print("I picked a number between 1 and 5.")

while True:
    try:
        guess = int(input("Enter your guess: "))

        if guess == secret_number:
            print("Correct! You guessed the secret number!")
            break
        else:
            print("Wrong! Try again.")

    except ValueError:
        print("Please enter a whole number.")

# Step 6: Use ceil() and floor()
print("\n===== Decimal Calculator =====")

decimal_number = float(input("Enter a decimal number: "))

rounded_up = math.ceil(decimal_number)
rounded_down = math.floor(decimal_number)

print("Rounded up using ceil():", rounded_up)
print("Rounded down using floor():", rounded_down)

# Step 7: Use copysign() and fabs()
x = float(input("\nEnter a number for copysign(): "))
y = float(input("Enter another number for its sign: "))

copied_sign = math.copysign(x, y)
absolute_value = math.fabs(x)

print("copysign() result:", copied_sign)
print("fabs() absolute value:", absolute_value)

# Step 8: Use gcd()
num1 = int(input("\nEnter the first whole number: "))
num2 = int(input("Enter the second whole number: "))

greatest_divisor = math.gcd(num1, num2)

print("Greatest Common Divisor (GCD):", greatest_divisor)

# Step 9: Final summary
print("\n===== Random Fun Calculator Summary =====")
print("Lucky number:", lucky_number)
print("Random activity:", activity)
print("Secret number:", secret_number)
print("Decimal number:", decimal_number)
print("Ceil result:", rounded_up)
print("Floor result:", rounded_down)
print("Copysign result:", copied_sign)
print("Absolute value:", absolute_value)
print("GCD:", greatest_divisor)

print("\nThanks for using the Random Fun Calculator!")
